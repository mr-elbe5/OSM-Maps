        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Einstellungen können diverse Voreinstellungen geändert sowie Kartenkacheln für Offline-Nutzung vorgeladen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Preferences you can change various presets of the app and preload map tiles for offline use."
