            "state" : "translated",
            "value" : "Notes"
          }
        }
      }
    },
    "helpNotesText" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Liste zeigt alle Notizen der App. Sie können dort auf der Karte angezeigt, editiert oder gelöscht werden.\n\nDas Menü oben von links:\n- Reihenfolge umkehren\n- alle auswählen/abwählen\n\nDas Detailmenü von links:\n- Kartenposition anzeigen\n- Notiz editieren\n- Auswahl umkehren\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The note list shows all notes of this app.\nThere they can be shown on the map, edited or deleted.\n\nThe top menu from left:\n- toggle sorting\n- toggle selection\n\nThe detail menu from left:\n- show position on map\n- edit note\n- toggle selection\n"
          }
        }
      }
    },
