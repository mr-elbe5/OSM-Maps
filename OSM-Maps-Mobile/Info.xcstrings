{
  "sourceLanguage" : "en",
  "strings" : {
    "detailInfoText" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detailansichten können einzelne Ansichten von Bildern, Notizen oder Touren sein. Es können aber auch wie in den Listenansichten aus dem oberen Menü Listen von solchen Elementen sein. "
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Details may be single views of images, notes or tracks or it may be a list of such items like in the list views from top menu."
          }
        }
      }
    },
    "elbe5LegalInfo" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regeln für das Laden von Elbe5.de"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legal Info for tiles from Elbe5.de"
          }
        }
      }
    },
    "generalInfoText" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App zeigt OSM-basierte Karten aus wählbaren Quellen (siehe Einstellungen), kann Bilder aufnehmen, Bilder und Notizen zuordnen und Tourenaufnahmen erzeugen.\n\nSie kann all dies über Backup-Dateien mit der Desktop-App synchronisieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app shows OSM based maps from a selectable source (see top menu - gear icon), can take photos, add images and notes and create tracks.\nIt can synchronize all of that via backup files with the desktop app."
          }
        }
      }
    },
