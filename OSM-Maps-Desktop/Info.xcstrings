    "mapPreloadHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier kannst Du Kartenkacheln für den aktuell sichtbaren Kartenbereich und verschiedene Zoomebenen vorladen.\nBITTE BEACHTEN! Für Massendownloads solltest Du die entsprechenden Rechte haben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Here you can preload map tiles for the currently visible map area for selected zoom levels.\nPLEASE NOTE! For mass downloads you should have respective rights."
          }
        }
      }
    },
    "maxMergeDistanceHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn ein neuer Ort benötigt wird und es existiert ein Ort in einer Entfernung unter diesem Wert, wird dieser Ort benutzt und kein neuer erstellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If a new location is needed and its coordinates are closer than this distance to another locations coordinates, this location is used and no new location is created."
          }
        }
      }
    },
    "nameOrDescriptionHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trage bitte einen Namen oder eine Beschreibung für diese Tour ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please enter a name for this track"
          }
        }
      }
    },
