    "helpPresenterText" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der Diaschau kann mit den Pfeilen rechts und links zwischen den enthaltenen Bildern. Videos und Audios navigiert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the slideshow view you can navigate between the selected media with the arrows on the left and on the right."
          }
        }
      }
    },
